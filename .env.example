# ── AI Provider ──────────────────────────────────────────────────────────────
# Set the key for whichever provider you build with (-Pantropic or -Popenai).
# Only the key for the active provider needs to be set.

# Anthropic (default — used with: ./mvnw spring-boot:run)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (used with: ./mvnw spring-boot:run -Popenai)
OPENAI_API_KEY=your-openai-api-key-here

# ── Email ─────────────────────────────────────────────────────────────────────
# Gmail address used to send emails
MAIL_USERNAME=ashu936@gmail.com

# Gmail App Password (NOT your account password)
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your Google account
MAIL_PASSWORD=your-gmail-app-password-here

# Recipient email address(es) — comma-separated for multiple recipients
# Default (if unset): ashu936@gmail.com
# Single:   MAIL_TO=ashu936@gmail.com
# Multiple: MAIL_TO=ashu936@gmail.com,colleague@example.com
MAIL_TO=ashu936@gmail.com

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron schedule (America/Chicago timezone). Omit to use the default.
# Default: Mon/Wed/Fri 7:30 AM CST  →  0 30 7 * * MON,WED,FRI
# SIGNAL_FEED_CRON=0 30 7 * * MON,WED,FRI
